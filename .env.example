# Threat-intelligence platform (compromised credential tickets)
THREAT_INTEL_BASE_URL=https://api.example.com/threat-stream/v4
THREAT_INTEL_API_TOKEN=your-api-token
THREAT_INTEL_AUTH_SCHEME=Token
THREAT_INTEL_VERIFY_SSL=true
HTTP_PROXY_URL=
HTTPS_PROXY_URL=
TICKET_STATUS=open
CORPORATE_ONLY=true

# Processing
BATCH_THRESHOLD=3
SKIP_PHONE_USERNAMES=true
FALLBACK_MANAGER_EMAIL=security-team@example.com
STATE_FILE=data/processed_tickets.json

# Mail
SMTP_HOST=smtp.example.com
SMTP_PORT=25
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=soc-notifications@example.com
# true = log only, nothing is sent
DRY_RUN=true
# When set, every mail goes to this address instead of the manager (pilot phase)
TEST_RECIPIENT=

# Active Directory
LDAP_SERVER=dc01.example.com
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_USER_DN=CN=svc-ldap-read,OU=Service Accounts,DC=example,DC=com
LDAP_PASSWORD=your-ldap-password
# Searched in order, separated by ";" (narrow OU first, domain root as fallback)
LDAP_SEARCH_BASES=OU=Staff,DC=example,DC=com;DC=example,DC=com

# Critical leaks -> SOAR incident (regex, case-insensitive)
CRITICAL_DEVICE_PATTERN=^CORP-
CRITICAL_USERNAME_PATTERN=@example\.com$
SOAR_ENABLED=false
SOAR_HOST=soar.example.com
SOAR_PORT=443
SOAR_ORG=Example Org
SOAR_API_KEY_ID=your-api-key-id
SOAR_API_KEY_SECRET=your-api-key-secret
SOAR_CAFILE=
SOAR_INCIDENT_TYPE=
